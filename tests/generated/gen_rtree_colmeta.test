# Generated test (LLM): pair SQLITE_ENABLE_RTREE x SQLITE_ENABLE_COLUMN_METADATA.
# Gap: no existing quick-suite file guards on both rtree and columnmetadata.
# Oracle as in gen_fts5_colmeta.test; CHARACTERIZATION marks observed behaviour.
source [file join [file dirname [info script]] common.tcl]
set testprefix gen_rtree_colmeta
ifcapable !rtree { finish_test ; return }

proc origins {sql} {
  set stmt [sqlite3_prepare_v2 db $sql -1 dummy]
  set res [list]
  for {set i 0} {$i < [sqlite3_column_count $stmt]} {incr i} {
    lappend res [sqlite3_column_table_name $stmt $i] [sqlite3_column_origin_name $stmt $i]
  }
  sqlite3_finalize $stmt
  set res
}

do_execsql_test 1.0 {
  CREATE VIRTUAL TABLE rt USING rtree(id, x0, x1, +label TEXT);
  INSERT INTO rt VALUES(1, 0, 10, 'first');
}
ifcapable columnmetadata {
  do_test 1.1 { origins {SELECT id, x0, label FROM rt} } {rt id rt x0 rt label}
  do_test 1.2 { origins {SELECT x1-x0 FROM rt} } {{} {}}
  do_test 1.3 { origins {SELECT nodeno, data FROM rt_node} } {rt_node nodeno rt_node data}
}
# Declared types of R-tree columns. The R-tree module declares auxiliary columns by name
# only, so a type written after "+label" is dropped (ext/rtree/rtree.c:3664). Revised after
# the first validation run, which expected TEXT.
do_test 2.1 { lindex [sqlite3_table_column_metadata db main rt label] 0 } {}
do_test 2.2 { lindex [sqlite3_table_column_metadata db main rt_node nodeno] 3 } {1}

finish_test
