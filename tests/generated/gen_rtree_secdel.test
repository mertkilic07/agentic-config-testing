# Generated test (LLM): pair SQLITE_ENABLE_RTREE x SQLITE_SECURE_DELETE.
# Gap: no existing quick-suite file guards on both rtree and secure_delete.
# Oracle: documentation of PRAGMA secure_delete and of rtreecheck().
source [file join [file dirname [info script]] common.tcl]
set testprefix gen_rtree_secdel
ifcapable !rtree { finish_test ; return }

# A distinctive 64-bit rowid; R-tree nodes store it as 8 big-endian bytes.
set MARK 6510615555426900570  ;# 0x5A5A5A5A5A5A5A5A
set NEEDLE [binary format W $MARK]

# 1. Deleting an R-tree entry with secure_delete in effect leaves no copy of it in the file.
do_execsql_test 1.0 "
  PRAGMA journal_mode = DELETE;
  CREATE VIRTUAL TABLE rt USING rtree(id, x0, x1, y0, y1);
  WITH s(i) AS (SELECT 1 UNION ALL SELECT i+1 FROM s WHERE i<500)
    INSERT INTO rt SELECT i, i, i+1, i, i+1 FROM s;
  INSERT INTO rt VALUES($MARK, 10.0, 20.0, 10.0, 20.0);
" {delete}
do_execsql_test 1.1 "DELETE FROM rt WHERE id=$MARK; SELECT count(*) FROM rt" {500}
do_execsql_test 1.2 { SELECT rtreecheck('rt'); PRAGMA integrity_check } {ok ok}
ifcapable secure_delete {
  do_test 1.3 { db close ; gen_file_contains test.db $NEEDLE } 0
  sqlite3 db test.db
}

# 1b. The same with the runtime pragma, so the check also runs on builds without the
#     compile-time option. FINDING (validation run, 17 Nov 2026): this fails. nodeDeleteCell()
#     (ext/rtree/rtree.c:834) shifts the following cells with memmove() and decrements the
#     cell count, but never clears the now-unused last slot of the node. The deleted entry is
#     still inside the live node blob, so page-level secure_delete cannot zero it.
reset_db
do_execsql_test 1.4 "
  PRAGMA journal_mode = DELETE;
  PRAGMA secure_delete = ON;
  CREATE VIRTUAL TABLE rt USING rtree(id, x0, x1, y0, y1);
  WITH s(i) AS (SELECT 1 UNION ALL SELECT i+1 FROM s WHERE i<500)
    INSERT INTO rt SELECT i, i, i+1, i, i+1 FROM s;
  INSERT INTO rt VALUES($MARK, 10.0, 20.0, 10.0, 20.0);
  DELETE FROM rt WHERE id=$MARK;
" {delete 1}
do_test 1.5 { db close ; gen_file_contains test.db $NEEDLE } 0
sqlite3 db test.db

# 2. Large deletes force node merges (CondenseTree); the tree must stay consistent and
#    queries correct with secure_delete on or off.
foreach {tn sd} {1 0 2 1} {
  reset_db
  do_execsql_test 2.$tn.0 "
    PRAGMA secure_delete = $sd;
    CREATE VIRTUAL TABLE rt USING rtree(id, x0, x1, y0, y1);
    WITH s(i) AS (SELECT 1 UNION ALL SELECT i+1 FROM s WHERE i<2000)
      INSERT INTO rt SELECT i, i%97, i%97+1, i%89, i%89+1 FROM s;
    DELETE FROM rt WHERE id%3 != 0;
    SELECT count(*), sum(id) FROM rt;
  " [list $sd 666 666333]
  do_execsql_test 2.$tn.1 { SELECT rtreecheck('rt') } ok
  do_execsql_test 2.$tn.2 {
    SELECT count(*) FROM rt WHERE x0>=10 AND x1<=20 AND y0>=10 AND y1<=20
  } [db one {SELECT count(*) FROM rt WHERE x0+0>=10 AND x1+0<=20 AND y0+0>=10 AND y1+0<=20}]
}

finish_test
