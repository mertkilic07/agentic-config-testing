# Generated test (LLM): pair SQLITE_ENABLE_FTS5 x SQLITE_ENABLE_FTS3 (outside the pilot model).
# Motivation: fts5corrupt3-74.1/75.1 fail when FTS5 is on and FTS3 is off
# (tests/existing/fts5corrupt3-matchinfo.md). This test states the behaviour of matchinfo()
# on an FTS5 table for both settings of FTS3, with correct guards.
source [file join [file dirname [info script]] common.tcl]
set testprefix gen_fts5_fts3
ifcapable !fts5 { finish_test ; return }

do_execsql_test 1.0 {
  CREATE VIRTUAL TABLE t1 USING fts5(a);
  INSERT INTO t1 VALUES('e1 e2');
}
ifcapable fts3 {
  # FTS3 overloads matchinfo() on every connection: calling it on an FTS5 table fails
  # with the placeholder message.
  do_catchsql_test 1.1 { SELECT matchinfo(t1) FROM t1 WHERE t1 MATCH 'e1' } \
    {1 {unable to use function matchinfo in the requested context}}
}
ifcapable !fts3 {
  do_catchsql_test 1.1 { SELECT matchinfo(t1) FROM t1 WHERE t1 MATCH 'e1' } \
    {1 {no such function: matchinfo}}
}
# Either way the query is rejected; FTS5's own auxiliary functions still work.
do_execsql_test 1.2 { SELECT bm25(t1) < 0 FROM t1 WHERE t1 MATCH 'e1' } 1
finish_test
